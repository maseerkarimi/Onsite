// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole  @default(BUILDER)
  phone         String?
  company       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  projects      Project[]
  crewMembers   CrewMember[]
  dailyLogs     DailyLog[]
  documents     Document[]
  photos        Photo[]
  
  @@index([email])
}

enum UserRole {
  ADMIN
  BUILDER
  CLIENT
  CREW_MEMBER
}

model Project {
  id              String    @id @default(cuid())
  name            String
  description     String?
  address         String
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  budget          Float?
  ownerId         String
  clientName      String?
  clientEmail     String?
  clientPhone     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  owner           User      @relation(fields: [ownerId], references: [id])
  crews           Crew[]
  documents       Document[]
  photos          Photo[]
  dailyLogs       DailyLog[]
  scopes          ScopeOfWork[]
  estimates       Estimate[]
  invoices        Invoice[]
  changeOrders    ChangeOrder[]
  warranties      Warranty[]
  
  @@index([ownerId])
  @@index([status])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Crew {
  id              String    @id @default(cuid())
  name            String
  specialty       String?
  projectId       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  members         CrewMember[]
  dailyLogs       DailyLog[]
  
  @@index([projectId])
}

model CrewMember {
  id              String    @id @default(cuid())
  userId          String
  crewId          String
  role            String?
  hourlyRate      Float?
  joinedAt        DateTime  @default(now())
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  crew            Crew      @relation(fields: [crewId], references: [id])
  
  @@unique([userId, crewId])
  @@index([crewId])
}

model Document {
  id              String    @id @default(cuid())
  name            String
  type            DocumentType
  url             String
  size            Int
  projectId       String
  uploadedById    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])
  
  @@index([projectId])
  @@index([type])
}

enum DocumentType {
  CONTRACT
  PERMIT
  PLAN
  SPECIFICATION
  DRAWING
  REPORT
  OTHER
}

model Photo {
  id              String    @id @default(cuid())
  name            String?
  url             String
  caption         String?
  projectId       String
  uploadedById    String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now())
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])
  
  @@index([projectId])
  @@index([createdAt])
}

model DailyLog {
  id              String    @id @default(cuid())
  projectId       String
  crewId          String?
  date            DateTime
  weather         String?
  temperature     String?
  workPerformed   String
  materials       String?
  equipment       String?
  visitors        String?
  safety          String?
  issues          String?
  notes           String?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  crew            Crew?     @relation(fields: [crewId], references: [id])
  author          User      @relation(fields: [authorId], references: [id])
  
  @@index([projectId])
  @@index([date])
}

model ScopeOfWork {
  id              String    @id @default(cuid())
  projectId       String
  title           String
  description     String
  category        String?
  aiGenerated     Boolean   @default(false)
  aiRiskLevel     String?   // LOW, MEDIUM, HIGH
  aiRiskFactors   String?   // JSON string
  status          ScopeStatus @default(DRAFT)
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  
  @@index([projectId])
  @@index([status])
}

enum ScopeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

model Estimate {
  id              String    @id @default(cuid())
  projectId       String
  title           String
  description     String?
  items           String    // JSON string of line items
  subtotal        Float
  tax             Float     @default(0)
  total           Float
  validUntil      DateTime?
  status          EstimateStatus @default(DRAFT)
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  
  @@index([projectId])
  @@index([status])
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

model Invoice {
  id              String    @id @default(cuid())
  projectId       String
  invoiceNumber   String    @unique
  title           String
  description     String?
  items           String    // JSON string of line items
  subtotal        Float
  tax             Float     @default(0)
  total           Float
  paidAmount      Float     @default(0)
  dueDate         DateTime?
  status          InvoiceStatus @default(DRAFT)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  
  @@index([projectId])
  @@index([status])
  @@index([invoiceNumber])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model ChangeOrder {
  id              String    @id @default(cuid())
  projectId       String
  orderNumber     String
  title           String
  description     String
  reason          String?
  originalAmount  Float
  changeAmount    Float
  newAmount       Float
  status          ChangeOrderStatus @default(PENDING)
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  
  @@index([projectId])
  @@index([status])
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

model Warranty {
  id              String    @id @default(cuid())
  projectId       String
  item            String
  description     String?
  provider        String?
  startDate       DateTime
  endDate         DateTime
  documentation   String?
  status          WarrantyStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  project         Project   @relation(fields: [projectId], references: [id])
  
  @@index([projectId])
  @@index([status])
  @@index([endDate])
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  VOID
}
